NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://discord:discord_dev_pw@localhost:5432/discord_clone
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-at-least-32chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

# Optional: require ACCEPTED friendship before starting DMs (true/false)
DM_REQUIRE_FRIENDSHIP=false

# Password reset: auto | dev-sink | noop
PASSWORD_RESET_MAILER=auto

# S3-compatible attachments (MinIO local defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=discord-clone-uploads
S3_FORCE_PATH_STYLE=true
ATTACHMENT_MAX_BYTES=8388608

# Voice / WebRTC (self-hosted coturn — see README & infra/voice/README.md)
VOICE_TOPOLOGY=mesh
VOICE_MESH_MAX_PARTICIPANTS=8
ICE_STUN_URLS=stun:localhost:3478
ICE_TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
ICE_TURN_USERNAME=discord
ICE_TURN_CREDENTIAL=discord_turn_dev
# Optional: full override (JSON array of RTCIceServer objects)
# ICE_SERVERS_JSON=[{"urls":"stun:localhost:3478"}]
