generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  email       String   @unique
  password    String
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  isAdmin     Boolean  @default(false) @map("is_admin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  analyticsEvents     AnalyticsEvent[]
  ownedServers        Server[]          @relation("ServerOwner")
  memberships         Member[]
  createdInvites      Invite[]
  messages            Message[]
  dmParticipations    DmParticipant[]
  directMessages      DirectMessage[]
  friendshipsA        Friendship[]      @relation("FriendA")
  friendshipsB        Friendship[]      @relation("FriendB")
  messageAttachments  MessageAttachment[]
  messageReactions    MessageReaction[]
  pinnedMessages      PinnedMessage[]   @relation("PinnedBy")
  notifications       InAppNotification[]
  serverBansReceived  ServerBan[]              @relation("BannedUser")
  serverBansIssued    ServerBan[]              @relation("BanIssuer")
  moderationActions   ModerationAuditEvent[]   @relation("ModerationActor")
  moderationTargets   ModerationAuditEvent[]   @relation("ModerationTarget")
  dataExportJobs      UserDataExportJob[]
  billingCustomer     BillingCustomer?
  entitlements        Entitlement[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  serverId  String?  @map("server_id")
  name      String
  payload   String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics_events")
}

// ─── Phase 2: Servers + Membership ──────────────────────────────────

model Server {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?  @map("icon_url")
  bannerUrl   String?  @map("banner_url")
  ownerId     String   @map("owner_id")
  visibility  String   @default("PRIVATE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner    User      @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  Member[]
  invites  Invite[]
  channels Channel[]
  bans     ServerBan[]
  moderationAuditEvents ModerationAuditEvent[]
  entitlements          Entitlement[]

  @@index([ownerId])
  @@index([slug])
  @@map("servers")
}

model Member {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  serverId String   @map("server_id")
  nickname String?
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now()) @map("joined_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
  @@index([userId])
  @@map("members")
}

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  serverId  String    @map("server_id")
  creatorId String    @map("creator_id")
  maxUses   Int?      @map("max_uses")
  uses      Int       @default(0)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([serverId])
  @@map("invites")
}

// ─── Phase 3: Channels ──────────────────────────────────────────────

model Channel {
  id              String   @id @default(uuid())
  serverId        String   @map("server_id")
  name            String
  topic           String?
  type            String   @default("TEXT")
  position        Int      @default(0)
  parentMessageId String?  @unique @map("parent_message_id")
  parentChannelId String?  @map("parent_channel_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  server              Server              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages            Message[]
  attachments         MessageAttachment[]
  pinnedMessages      PinnedMessage[]
  parentMessage       Message?            @relation("ThreadChannel", fields: [parentMessageId], references: [id], onDelete: Cascade)
  parentChannel       Channel?            @relation("ThreadParent", fields: [parentChannelId], references: [id], onDelete: Cascade)
  childThreadChannels Channel[]           @relation("ThreadParent")

  @@index([serverId])
  @@index([parentChannelId])
  @@map("channels")
}

// ─── Phase 4: Messages ──────────────────────────────────────────────

model Message {
  id        String    @id @default(uuid())
  channelId String    @map("channel_id")
  authorId  String    @map("author_id")
  content   String
  editedAt  DateTime? @map("edited_at")
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  channel         Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author          User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments     MessageAttachment[]
  reactions       MessageReaction[]
  pin             PinnedMessage?
  threadChannel   Channel?             @relation("ThreadChannel")

  @@index([channelId, createdAt])
  @@index([authorId])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String?  @map("message_id")
  channelId  String   @map("channel_id")
  uploaderId String   @map("uploader_id")
  storageKey String   @map("storage_key")
  filename   String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at")

  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  channel  Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([channelId, uploaderId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model PinnedMessage {
  id         String   @id @default(uuid())
  channelId  String   @map("channel_id")
  messageId  String   @unique @map("message_id")
  pinnedById String   @map("pinned_by_id")
  pinnedAt   DateTime @default(now()) @map("pinned_at")

  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation("PinnedBy", fields: [pinnedById], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([channelId])
  @@map("pinned_messages")
}

model InAppNotification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  serverId  String?   @map("server_id")
  channelId String?   @map("channel_id")
  messageId String?   @map("message_id")
  actorId   String?   @map("actor_id")
  summary   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("in_app_notifications")
}

// ─── Phase 5: Direct Messages ────────────────────────────────────────

model DmConversation {
  id           String          @id @default(uuid())
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  participants DmParticipant[]
  messages     DirectMessage[]

  @@map("dm_conversations")
}

model DmParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("dm_participants")
}

model DirectMessage {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  authorId       String    @map("author_id")
  content        String
  editedAt       DateTime? @map("edited_at")
  deleted        Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@map("direct_messages")
}

model Friendship {
  id            String   @id @default(uuid())
  userAId       String   @map("user_a_id")
  userBId       String   @map("user_b_id")
  requestedById String?  @map("requested_by_id")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")

  userA User @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("friendships")
}

// ─── Phase 4 (parity): Moderation, search metadata ───────────────────

model ServerBan {
  id         String    @id @default(uuid())
  serverId   String    @map("server_id")
  userId     String    @map("user_id")
  bannedById String    @map("banned_by_id")
  reason     String?
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User   @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User   @relation("BanIssuer", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@map("server_bans")
}

// Append-only moderation audit trail (no message bodies unless report flow).
model ModerationAuditEvent {
  id           String   @id @default(uuid())
  serverId     String   @map("server_id")
  actorUserId  String   @map("actor_user_id")
  action       String
  targetUserId String?  @map("target_user_id")
  metadata     String   @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actor  User   @relation("ModerationActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target User?  @relation("ModerationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt])
  @@index([actorUserId])
  @@map("moderation_audit_events")
}

model UserDataExportJob {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  status        String    @default("PENDING")
  downloadToken String?   @unique @map("download_token")
  payload       String?
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_data_export_jobs")
}

// ─── Phase 6: Billing (Stripe) — cosmetics only; isolated from chat analytics ─

model BillingCustomer {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  stripeCustomerId String   @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_customers")
}

model Entitlement {
  id                     String    @id @default(uuid())
  userId                 String    @map("user_id")
  kind                   String
  status                 String    @default("ACTIVE")
  serverId               String?   @map("server_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  validUntil             DateTime? @map("valid_until")
  lastStripeEventId      String?   @map("last_stripe_event_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId, kind, status])
  @@index([serverId, kind, status])
  @@map("entitlements")
}
